{
  "name": "@swaggerexpert/jsonpath",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "version": "4.1.0",
  "description": "RFC 9535 implementation of JSONPath",
  "unpkg": "./dist/jsonpath.browser.min.js",
  "jsdelivr": "./dist/jsonpath.browser.min.js",
  "main": "./cjs/index.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "watch": {
    "test": "{src,test}/**/*.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "grammar:compile": "node ./scripts/apg-js.js --lite --in=./src/grammar.bnf --out=./src/grammar.js && cd ./src",
    "build": "npm run grammar:compile && npm run build:es && npm run build:cjs && npm run build:cjs:apg-lite && npm run build:types && npm run build:umd:browser",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir es --extensions '.js' --out-file-extension '.mjs'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir cjs --extensions '.js' --out-file-extension '.cjs'",
    "build:cjs:apg-lite": "cross-env BABEL_ENV=cjs babel node_modules/apg-lite/lib/parser.js --out-file ./cjs/apg-lite.cjs",
    "build:types": "node ./scripts/build-types.cjs",
    "build:umd:browser": "cross-env BABEL_ENV=browser webpack --config config/webpack/browser.config.js --progress",
    "test": "cross-env UPDATE_SNAPSHOT=new mocha",
    "test:artifacts": "node ./test/artifacts/smoke.cjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck false --module node16 --moduleResolution node16 --target es2020 test/artifacts/types/consumer.cts test/artifacts/types/consumer.mts && tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2020 test/artifacts/types/consumer.mts",
    "test:watch": "npm-watch test",
    "watch": "npm-watch"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/swaggerexpert/jsonpath.git"
  },
  "keywords": [
    "jsonpath",
    "parser",
    "validator",
    "compiler",
    "evaluator",
    "rfc9535"
  ],
  "author": "Vladimír Gorej <vladimir.gorej@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/swaggerexpert/jsonpath/issues"
  },
  "homepage": "https://github.com/swaggerexpert/jsonpath#readme",
  "files": [
    "es/",
    "cjs/",
    "dist/",
    "types/",
    "LICENSE",
    "NOTICE",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "apg-lite": "^1.0.8"
  },
  "devDependencies": {
    "@babel/cli": "=8.1.0",
    "@babel/core": "=8.1.3",
    "@babel/preset-env": "=8.0.7",
    "@commitlint/cli": "=21.2.4",
    "@commitlint/config-conventional": "=21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "apg-js": "^4.4.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "chai": "=6.3.0",
    "cross-env": "^10.0.0",
    "husky": "=9.1.7",
    "mocha": "=11.8.0",
    "mocha-expect-snapshot": "^8.0.0",
    "npm-watch": "^0.13.0",
    "prettier": "^3.5.2",
    "semantic-release": "^26.0.1",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^7.0.2",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  }
}
